<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sails PoC: a native Rust + OpenGL ES browser shell around the Cefrium
      (pinned Chromium) engine.

      The engine's own manifest (merged in from the cefrium-sdk AAR) declares
      the multi-process child services and required permissions; we declare
      nothing for it here.
    -->

    <application
        android:label="Sails"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.Sails">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
